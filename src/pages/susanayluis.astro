---
/*
|--------------------------------------------------------------------------
| Invitación Digital - Boda Susana & Luis (solo móvil)
|--------------------------------------------------------------------------
| Papel crema en un solo tono de verde olivo: papel rasgado sobre las
| fotos, flores a línea, títulos en letra script y monograma S&L.
|--------------------------------------------------------------------------
*/
import "@fontsource/cinzel/400.css";
import "@fontsource/cinzel/500.css";
import "@fontsource/cinzel/600.css";
import "@fontsource/quicksand/400.css";
import "@fontsource/quicksand/500.css";
import "@fontsource/quicksand/600.css";
import "@fontsource/great-vibes/400.css";

// ===== Datos del evento (editar aquí) =====
const evento = {
  diaSemana: "Sábado",
  dia: "06",
  mes: "Marzo",
  anio: "2027",
  hora: "5:00 PM", // POR CONFIRMAR
  // 6 mar 2027, 5:00 p.m. hora del centro de México (UTC-6)
  iso: "2027-03-06T17:00:00-06:00",
  lugar: "Nombre del lugar", // POR CONFIRMAR
  direccion: "Dirección por confirmar", // POR CONFIRMAR
};
const mapsUrl = ""; // POR CONFIRMAR: link de Google Maps del lugar

const calUrl =
  "https://calendar.google.com/calendar/render?action=TEMPLATE" +
  "&text=" + encodeURIComponent("Boda de Susana & Luis") +
  "&dates=20270306T230000Z/20270307T050000Z" +
  "&details=" + encodeURIComponent("¡Nos casamos! Gracias por acompañarnos.") +
  "&location=" + encodeURIComponent(`${evento.lugar}, ${evento.direccion}`);

const SITE = "https://monrold.pages.dev";
const ogImage = `${SITE}/susanayluis/og-susanayluis-v4.jpg`;
const titulo = "La boda de Susana & Luis";

// ===== Papel rasgado (orilla irregular, determinista) =====
let s = 7;
const rnd = () => (s = (s * 16807) % 2147483647) / 2147483647;
function tornEdge(fill: string, seed: number) {
  s = seed;
  const pts: string[] = ["0,40"];
  let x = 0;
  while (x < 400) {
    pts.push(`${x.toFixed(1)},${(8 + rnd() * 16).toFixed(1)}`);
    x += 4 + rnd() * 10;
  }
  pts.push("400,14", "400,40");
  // Fibra blanca del rasgado debajo de la orilla
  const fiber = pts.map((p, i) => {
    if (i === 0 || i >= pts.length - 2) return p;
    const [px, py] = p.split(",").map(Number);
    return `${px},${(py - 2.5 - rnd() * 2).toFixed(1)}`;
  });
  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 40" preserveAspectRatio="none"><polygon points="${fiber.join(" ")}" fill="#ffffff" opacity=".85"/><polygon points="${pts.join(" ")}" fill="${fill}"/></svg>`;
}
const uri = (svg: string) => `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
const PAPER = "#f6f3ea";
const bgVars = [
  `--torn-a:${uri(tornEdge(PAPER, 11))}`,
  `--torn-b:${uri(tornEdge(PAPER, 29))}`,
  `--torn-c:${uri(tornEdge(PAPER, 53))}`,
  `--torn-olive:${uri(tornEdge("#56653a", 71))}`,
].join(";");

// Puntitos del centro de la flor
const petals = Array.from({ length: 11 }, (_, i) => i * (360 / 11));
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#f6f3ea" />
  <title>{titulo}</title>
  <meta name="description" content={`${evento.diaSemana} 6 de marzo de ${evento.anio}. Una boda pequeña con las personas que más queremos.`} />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={`${evento.diaSemana} 6 de marzo de ${evento.anio} · Abre tu invitación`} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`${SITE}/susanayluis`} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={titulo} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" as="image" href="/susanayluis/propuesta.jpg" />
</head>

<body style={bgVars}>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <!-- Flor a línea con tallo y hojas -->
      <symbol id="flor" viewBox="0 0 100 150">
        <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          {petals.map((a) => <path d="M50 38 C44 26 45 12 50 6 C55 12 56 26 50 38Z" transform={`rotate(${a} 50 40)`} />)}
          <circle cx="50" cy="40" r="7" />
          <path d="M47 39h.1M52 37h.1M50 43h.1M53 42h.1M46 43h.1" stroke-width="2.4" />
          <path d="M50 48 C49 78 53 108 46 148" />
          <path d="M50 96 C38 84 26 86 18 94 C30 102 42 100 50 96Z" />
          <path d="M38 92 C32 92 26 93 22 94" />
          <path d="M49 118 C60 104 72 104 80 110 C70 120 58 122 49 118Z" />
          <path d="M60 113 C66 111 72 110 77 110" />
        </g>
      </symbol>
      <!-- Ramita pequeña -->
      <symbol id="ramita" viewBox="0 0 60 100">
        <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M30 98 C30 70 28 40 32 6" />
          <path d="M31 30 C22 26 18 18 18 12 C26 14 31 22 31 30Z" />
          <path d="M31 50 C40 46 44 38 44 32 C36 34 31 42 31 50Z" />
          <path d="M30 70 C21 66 17 58 17 52 C25 54 30 62 30 70Z" />
          <circle cx="32" cy="5" r="3" />
        </g>
      </symbol>
      <path id="arcTop" d="M30 120 A110 110 0 0 1 250 120" />
      <!-- Textura de papel del sobre -->
      <filter id="paperTex" x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="3" seed="4" result="mottle" />
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="9" result="fine" />
        <feColorMatrix in="mottle" type="matrix" values="0 0 0 0 0.4  0 0 0 0 0.4  0 0 0 0 0.25  0 0 0 .09 0" result="m2" />
        <feColorMatrix in="fine" type="matrix" values="0 0 0 0 0.3  0 0 0 0 0.3  0 0 0 0 0.2  0 0 0 .16 0" result="f2" />
        <feMerge><feMergeNode in="m2" /><feMergeNode in="f2" /></feMerge>
      </filter>
      <filter id="wax" x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence type="fractalNoise" baseFrequency="0.06" numOctaves="2" seed="3" result="t" />
        <feDisplacementMap in="SourceGraphic" in2="t" scale="9" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <radialGradient id="waxGrad" cx="38%" cy="32%" r="72%">
        <stop offset="0" stop-color="#93a066" />
        <stop offset=".45" stop-color="#5f6e3c" />
        <stop offset="1" stop-color="#36401f" />
      </radialGradient>
      <radialGradient id="waxInner" cx="60%" cy="65%" r="70%">
        <stop offset="0" stop-color="#6e7d47" />
        <stop offset="1" stop-color="#4b5730" />
      </radialGradient>
    </defs>
  </svg>

  <!-- ============ Aviso de escritorio ============ -->
  <div id="solo-movil" role="alert">
    <div class="sm-card">
      <svg class="sm-flor" viewBox="0 0 100 150"><use href="#flor" /></svg>
      <p class="caps">La boda de Susana & Luis</p>
      <h1>Esta invitación es solo para celulares</h1>
      <p class="sm-sub">Ábrela desde tu teléfono para vivirla completa.</p>
    </div>
  </div>

  <!-- ============ Sobre (pantalla de entrada) ============ -->
  <div id="sobre" class="sobre">
    <svg class="flor-deco" style="width:120px;left:-26px;top:6%;transform:rotate(18deg)"><use href="#flor" /></svg>
    <svg class="flor-deco" style="width:96px;right:-18px;bottom:8%;transform:rotate(-160deg)"><use href="#flor" /></svg>
    <svg class="flor-deco" style="width:42px;right:14%;top:12%;transform:rotate(-12deg)"><use href="#ramita" /></svg>

    <div class="sobre-top">
      <p class="caps">Tienes una invitación</p>
      <p class="sobre-names">Susana <span>y</span> Luis</p>
    </div>

    <button class="envelope" id="envelope" type="button" aria-label="Abrir la invitación">
      <span class="env-back"></span>
      <span class="env-letter">
        <span class="caps small">La boda de</span>
        <span class="l-names">Susana <span>y</span> Luis</span>
        <span class="l-date">06 · 03 · 2027</span>
      </span>
      <span class="env-front"><svg class="tex" aria-hidden="true"><rect width="100%" height="100%" filter="url(#paperTex)" /></svg></span>
      <span class="env-flap"><svg class="tex" aria-hidden="true"><rect width="100%" height="100%" filter="url(#paperTex)" /></svg></span>
      <span class="env-seal">
        <svg viewBox="0 0 120 120" aria-hidden="true">
          <g filter="url(#wax)"><circle cx="60" cy="60" r="50" fill="url(#waxGrad)" /></g>
          <circle cx="60" cy="60" r="36" fill="url(#waxInner)" />
          <circle cx="60" cy="60" r="36" fill="none" stroke="#2c3418" stroke-opacity=".55" stroke-width="2.4" />
          <circle cx="60" cy="61.5" r="36" fill="none" stroke="#c4cf9a" stroke-opacity=".35" stroke-width="1.2" />
          <g fill="none" stroke="#2c3418" stroke-opacity=".45" stroke-width="1.3" stroke-linecap="round">
            <path d="M36 74c6-3 10-8 12-14M84 74c-6-3-10-8-12-14" />
            <path d="M40 71c-3-1-4-3-4-5 2 0 4 2 4 5zM80 71c3-1 4-3 4-5-2 0-4 2-4 5z" />
          </g>
          <text x="60" y="66" text-anchor="middle" class="seal-txt seal-shadow">S&amp;L</text>
          <text x="60" y="64.5" text-anchor="middle" class="seal-txt">S&amp;L</text>
          <ellipse cx="44" cy="38" rx="11" ry="5" fill="#fff" opacity=".16" transform="rotate(-30 44 38)" />
        </svg>
      </span>
    </button>

    <p class="sobre-hint caps">Toca el sello para abrir</p>
    <p class="sobre-sound">Sube el volumen ♪</p>
  </div>

  <!-- ============ Invitación ============ -->
  <main id="app">
    <!-- PORTADA -->
    <section class="hero">
      <p class="caps lg reveal">La boda de</p>
      <h1 class="hero-names reveal">
        <span class="nm">Susana</span>
        <span class="y">y</span>
        <span class="nm">Luis</span>
      </h1>

      <div class="hero-photo reveal-zoom">
        <img src="/susanayluis/propuesta.jpg" alt="Luis pidiéndole matrimonio a Susana frente al agua" width="1000" height="1149" />
        <div class="mono mono-photo" aria-hidden="true"><span>S</span><i>&</i><span>L</span></div>
      </div>

      <div class="date-row reveal">
        <span class="dr-side">{evento.mes}</span>
        <span class="dr-num">{evento.dia}</span>
        <span class="dr-side">{evento.anio}</span>
      </div>

      <p class="quote reveal">“De todas las historias de amor,<br />la nuestra es nuestra favorita”</p>

      <div class="programa reveal">
        <svg class="flor-top" viewBox="0 0 100 150"><use href="#flor" /></svg>
        <div class="oval">
          <svg class="oval-arc" viewBox="0 0 280 140" aria-hidden="true">
            <text><textPath href="#arcTop" startOffset="50%" text-anchor="middle">Nuestra boda</textPath></text>
          </svg>
          <div class="mono mono-sm" aria-hidden="true"><span>S</span><i>&</i><span>L</span></div>
          <p class="pg-day">{evento.diaSemana}</p>
          <p class="pg-date">6 de marzo de 2027</p>
          <p class="pg-time">{evento.hora}</p>
          <p class="pg-note">Ceremonia y celebración</p>
        </div>
      </div>
    </section>

    <!-- NUESTRA HISTORIA -->
    <section class="torn-photo">
      <img src="/susanayluis/manos-arriba.jpg" alt="Susana y Luis juntando sus manos frente al agua" loading="lazy" width="900" height="900" />
      <span class="tear tear-top" style="background-image:var(--torn-a)"></span>
      <h2 class="script-over reveal">Nuestra historia</h2>
      <span class="tear tear-bottom" style="background-image:var(--torn-b)"></span>
    </section>
    <section class="block">
      <svg class="flor-deco" style="width:96px;right:-52px;top:-14px;transform:rotate(-24deg)"><use href="#flor" /></svg>
      <svg class="flor-deco" style="width:40px;left:14px;bottom:10px;transform:rotate(14deg)"><use href="#ramita" /></svg>
      <p class="body-lg reveal">Decidimos celebrar en pequeño, solo con las personas que más queremos.</p>
      <p class="body reveal">Por eso, que estés con nosotros ese día significa muchísimo. Tú eres parte de nuestra historia.</p>
    </section>

    <!-- LOS DETALLES -->
    <section class="torn-photo">
      <img src="/susanayluis/abrazo.jpg" alt="Susana abrazando a Luis frente al agua" loading="lazy" width="900" height="900" style="object-position:50% 40%" />
      <span class="tear tear-top" style="background-image:var(--torn-c)"></span>
      <h2 class="script-over reveal">Los detalles</h2>
      <span class="tear tear-bottom" style="background-image:var(--torn-a)"></span>
    </section>
    <section class="block">
      <svg class="flor-deco" style="width:96px;left:-28px;top:20px;transform:rotate(20deg)"><use href="#flor" /></svg>
      <p class="label reveal">Guarda la fecha</p>
      <p class="det-date reveal">{evento.diaSemana} 6 de marzo · {evento.hora}</p>

      <p class="label mt reveal">Faltan</p>
      <div id="cuenta" data-target={evento.iso}>
        <div class="tiles reveal" id="tiles">
          <div class="tile"><b data-u="d">--</b><span>días</span></div>
          <div class="tile"><b data-u="h">--</b><span>horas</span></div>
          <div class="tile"><b data-u="m">--</b><span>min</span></div>
          <div class="tile"><b data-u="s">--</b><span>seg</span></div>
        </div>
        <p class="hoy" id="hoy" hidden>¡Hoy es el gran día!</p>
      </div>

      <div class="palette reveal">
        <p class="label">Paleta de colores</p>
        <div class="dots"><i style="--c:#3f4b27"></i><i style="--c:#5f6e3c"></i><i style="--c:#8c9a64"></i><i style="--c:#c3cca3"></i><i style="--c:#e9ead9"></i></div>
      </div>

      <a class="btn reveal" href={calUrl} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
        Agregar a mi calendario
      </a>
    </section>

    <!-- LA UBICACIÓN -->
    <section class="block pt0">
      <h2 class="script-title reveal">La ubicación</h2>
    </section>
    <section class="torn-photo tall">
      <img src="/susanayluis/lugar.jpg" alt="Alberca entre cabañas y jardines" loading="lazy" width="1100" height="1100" style="object-position:50% 60%" />
      <span class="tear tear-top" style="background-image:var(--torn-b)"></span>
      <span class="tear tear-bottom" style="background-image:var(--torn-c)"></span>
    </section>
    <section class="block">
      <svg class="flor-deco" style="width:90px;right:-50px;top:40px;transform:rotate(-18deg)"><use href="#flor" /></svg>
      <h3 class="lugar-name reveal">{evento.lugar}</h3>
      <p class="body reveal">{evento.direccion}</p>
      {mapsUrl ? (
        <a class="btn reveal" href={mapsUrl} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z" /><circle cx="12" cy="10" r="2.5" /></svg>
          Cómo llegar
        </a>
      ) : (
        <span class="btn ghost reveal">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z" /><circle cx="12" cy="10" r="2.5" /></svg>
          Ubicación muy pronto
        </span>
      )}
    </section>

    <!-- GALERÍA -->
    <section class="torn-photo">
      <img src="/susanayluis/anillo-cerca.jpg" alt="Las manos de Susana y Luis, se ve el anillo de compromiso" loading="lazy" width="900" height="900" />
      <span class="tear tear-top" style="background-image:var(--torn-a)"></span>
      <h2 class="script-over reveal">Galería</h2>
      <span class="tear tear-bottom" style="background-image:var(--torn-b)"></span>
    </section>
    <section class="block">
      <div class="grid reveal">
        <img src="/susanayluis/propuesta.jpg" alt="La propuesta" loading="lazy" width="1000" height="1149" style="object-position:30% 60%" />
        <img src="/susanayluis/manos-arriba.jpg" alt="Sus manos juntas" loading="lazy" width="900" height="900" />
        <img src="/susanayluis/abrazo.jpg" alt="El abrazo" loading="lazy" width="900" height="900" />
      </div>
    </section>

    <!-- CIERRE -->
    <section class="block cierre">
      <svg class="flor-deco" style="width:100px;left:-54px;top:0;transform:rotate(16deg)"><use href="#flor" /></svg>
      <svg class="flor-deco" style="width:100px;right:-54px;top:40px;transform:rotate(-16deg) scaleX(-1)"><use href="#flor" /></svg>
      <h2 class="script-title reveal">Nos vemos ahí</h2>
      <p class="body reveal">Esperamos con mucha ilusión celebrar contigo.</p>
      <div class="mono mono-lg reveal" aria-hidden="true"><span>S</span><i>&</i><span>L</span></div>
      <p class="firma reveal">Susana & Luis</p>
      <p class="caps reveal">06 · 03 · 2027</p>
    </section>
    <div class="foot-band" aria-hidden="true"></div>
  </main>

  <audio id="musica" src="/susanayluis/cancion-boda-2.mp3" loop preload="auto"></audio>
  <button class="music-btn" id="musicBtn" type="button" aria-label="Pausar música" aria-pressed="true">
    <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
    <svg class="ic-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V5l11-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="17" cy="16" r="3" /><path d="M3 3l18 18" /></svg>
  </button>

  <script>
    const root = document.documentElement;
    const sobre = document.getElementById("sobre")!;
    const envelope = document.getElementById("envelope")!;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    root.classList.add("locked");
    window.scrollTo(0, 0);

    // Pétalos al abrir
    const colors = ["#ffffff", "#c3cca3", "#8c9a64", "#5f6e3c", "#f6f3ea"];
    function petals() {
      const r = envelope.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 3;
      for (let i = 0; i < 30; i++) {
        const p = document.createElement("span");
        p.className = "petal";
        const a = -Math.PI / 2 + (Math.random() - 0.5) * Math.PI * 1.4;
        const d = 100 + Math.random() * 160;
        p.style.left = cx + "px";
        p.style.top = cy + "px";
        p.style.background = colors[i % colors.length];
        p.style.setProperty("--dx", Math.cos(a) * d + "px");
        p.style.setProperty("--dy", Math.sin(a) * d + "px");
        p.style.setProperty("--rot", Math.random() * 540 - 270 + "deg");
        document.body.appendChild(p);
        setTimeout(() => p.remove(), 2400);
      }
    }

    // Música: arranca con el toque que abre el sobre (permitido en iOS/Android)
    const audio = document.getElementById("musica") as HTMLAudioElement;
    const musicBtn = document.getElementById("musicBtn")!;
    function setMusicUI(on: boolean) {
      musicBtn.classList.toggle("off", !on);
      musicBtn.setAttribute("aria-pressed", String(on));
      musicBtn.setAttribute("aria-label", on ? "Pausar música" : "Reproducir música");
    }
    function playMusic() {
      audio.volume = 0;
      audio.play().then(() => {
        setMusicUI(true);
        let v = 0;
        const fade = setInterval(() => { v = Math.min(0.85, v + 0.05); audio.volume = v; if (v >= 0.85) clearInterval(fade); }, 120);
      }).catch(() => setMusicUI(false));
      setTimeout(() => musicBtn.classList.add("show"), 1800);
    }
    musicBtn.addEventListener("click", () => {
      if (audio.paused) { audio.volume = 0.85; audio.play().then(() => setMusicUI(true)).catch(() => {}); }
      else { audio.pause(); setMusicUI(false); }
    });
    document.addEventListener("visibilitychange", () => {
      if (document.hidden && !audio.paused) { audio.pause(); musicBtn.dataset.resume = "1"; }
      else if (!document.hidden && musicBtn.dataset.resume) { delete musicBtn.dataset.resume; audio.play().catch(() => {}); }
    });

    let opened = false;
    function openInvite() {
      if (opened) return;
      opened = true;
      if (navigator.vibrate) navigator.vibrate(20);
      playMusic();
      sobre.classList.add("opening");
      if (!reduce) setTimeout(petals, 600);
      setTimeout(() => {
        sobre.classList.add("gone");
        root.classList.remove("locked");
        startReveal();
      }, reduce ? 300 : 2300);
      setTimeout(() => sobre.remove(), reduce ? 900 : 3300);
    }
    envelope.addEventListener("click", openInvite);

    // Aparición al hacer scroll
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
        }
      },
      { threshold: 0.15 }
    );
    function startReveal() {
      document.querySelectorAll(".reveal, .reveal-zoom").forEach((el) => io.observe(el));
    }

    // Cuenta regresiva
    const cuenta = document.getElementById("cuenta")!;
    const target = new Date(cuenta.dataset.target!).getTime();
    const units = {
      d: cuenta.querySelector<HTMLElement>('[data-u="d"]')!,
      h: cuenta.querySelector<HTMLElement>('[data-u="h"]')!,
      m: cuenta.querySelector<HTMLElement>('[data-u="m"]')!,
      s: cuenta.querySelector<HTMLElement>('[data-u="s"]')!,
    };
    const pad = (n: number) => String(n).padStart(2, "0");
    function tick() {
      let diff = Math.max(0, target - Date.now());
      if (diff === 0) {
        document.getElementById("tiles")!.hidden = true;
        document.getElementById("hoy")!.hidden = false;
        return false;
      }
      const d = Math.floor(diff / 864e5); diff -= d * 864e5;
      const h = Math.floor(diff / 36e5); diff -= h * 36e5;
      const m = Math.floor(diff / 6e4); diff -= m * 6e4;
      const sec = Math.floor(diff / 1e3);
      units.d.textContent = String(d);
      units.h.textContent = pad(h);
      units.m.textContent = pad(m);
      units.s.textContent = pad(sec);
      return true;
    }
    if (tick()) {
      const id = setInterval(() => { if (!tick()) clearInterval(id); }, 1000);
    }
  </script>

  <style is:global>
    :root {
