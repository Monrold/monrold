---
/*
|--------------------------------------------------------------------------
| Card de cumpleaños - "Feliz cumpleaños, carnal"
| Un solo botón, estilo limpio: blanco, azul y un toque de rojo.
|--------------------------------------------------------------------------
*/
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/800.css";

// Dominio público del sitio (para la og:image de WhatsApp)
const SITE = "https://monrold.pages.dev";
const ogImage = `${SITE}/cumple-carnal/og-cumple-carnal.jpg`;
const titulo = "¡Feliz cumpleaños, carnal!";
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#ffffff" />
  <title>{titulo}</title>
  <meta name="description" content="Te llegó un regalo. Pícale al botón." />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content="Te llegó un regalo 🏍️ Pícale al botón." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`${SITE}/cumple-carnal`} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={titulo} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" as="image" href="/cumple-carnal/kit-de-juntas.jpg" />
</head>

<body>
  <main class="stage" id="stage">
    <section class="intro">
      <p class="kicker">GSX-R 600 · Modelo 2000</p>
      <h1 class="title">¡Feliz cumpleaños,<br />carnal!</h1>
      <span class="rule" aria-hidden="true"></span>
      <button class="btn" id="btn" type="button">
        <span>Abrir mi regalo</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" /></svg>
      </button>
      <p class="note">Sube el volumen</p>
    </section>

    <section class="gift" id="gift" aria-live="polite">
      <img src="/cumple-carnal/kit-de-juntas.jpg" width="900" height="1079" alt="Tu regalo de cumpleaños: un kit de juntas para la GSX-R 600" />
      <button class="again" id="again" type="button">Acelerar otra vez</button>
    </section>
  </main>

  <canvas id="confeti" aria-hidden="true"></canvas>
  <audio id="motor" src="/cumple-carnal/gsxr600.mp3" preload="auto"></audio>

  <script>
    const stage = document.getElementById("stage")!;
    const audio = document.getElementById("motor") as HTMLAudioElement;
    function acelerar() {
      audio.currentTime = 0;
      audio.volume = 1;
      audio.play().catch(() => {});
      if (navigator.vibrate) navigator.vibrate([40, 60, 40, 60, 120]);
    }
    // Confeti (canvas, sin dependencias)
    const cv = document.getElementById("confeti") as HTMLCanvasElement;
    const ctx = cv.getContext("2d")!;
    const colores = ["#0b3fa8", "#2f6bea", "#e2231a", "#ffffff", "#0b3fa8", "#c9d6f2"];
    type P = { x: number; y: number; vx: number; vy: number; r: number; w: number; h: number; c: string; s: number; t: number };
    let parts: P[] = [];
    let anim = 0;
    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      cv.width = innerWidth * dpr; cv.height = innerHeight * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    function lanzar(x: number, y: number, n: number, ang: number, spread: number, fuerza: number) {
      for (let i = 0; i < n; i++) {
        const a = ang + (Math.random() - 0.5) * spread;
        const v = fuerza * (0.55 + Math.random() * 0.6);
        parts.push({
          x, y, vx: Math.cos(a) * v, vy: Math.sin(a) * v, r: Math.random() * Math.PI,
          w: 6 + Math.random() * 6, h: 3 + Math.random() * 5, c: colores[i % colores.length],
          s: (Math.random() - 0.5) * 0.3, t: 0,
        });
      }
      if (!anim) anim = requestAnimationFrame(paso);
    }
    function paso() {
      ctx.clearRect(0, 0, innerWidth, innerHeight);
      parts = parts.filter((p) => p.y < innerHeight + 30 && p.t < 420);
      for (const p of parts) {
        p.t++; p.vy += 0.22; p.vx *= 0.985; p.vy *= 0.985;
        p.x += p.vx + Math.sin(p.t / 9) * 0.6; p.y += p.vy; p.r += p.s;
        ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.r);
        ctx.scale(1, Math.cos(p.t / 6));
        ctx.fillStyle = p.c; ctx.strokeStyle = "rgba(11,63,168,.25)"; ctx.lineWidth = 0.6;
        ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
        if (p.c === "#ffffff") ctx.strokeRect(-p.w / 2, -p.h / 2, p.w, p.h);
        ctx.restore();
      }
      anim = parts.length ? requestAnimationFrame(paso) : 0;
      if (!anim) ctx.clearRect(0, 0, innerWidth, innerHeight);
    }
    function confeti(n = 1) {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      resize();
      const W = innerWidth, H = innerHeight;
      lanzar(0, H * 0.7, 90 * n, -Math.PI / 3, 0.9, 19);
      lanzar(W, H * 0.7, 90 * n, (-2 * Math.PI) / 3, 0.9, 19);
      setTimeout(() => lanzar(W / 2, H * 0.35, 70 * n, -Math.PI / 2, Math.PI * 1.6, 11), 250);
    }
    addEventListener("resize", () => { if (anim) resize(); });

    document.getElementById("btn")!.addEventListener("click", () => {
      acelerar();
      stage.classList.add("opened");
      setTimeout(() => confeti(), 450);
    });
    document.getElementById("again")!.addEventListener("click", () => { acelerar(); confeti(0.6); });
    document.addEventListener("visibilitychange", () => { if (document.hidden) audio.pause(); });
  </script>

  <style is:global>
    :root { --azul: #0b3fa8; --azul-osc: #082f7e; --rojo: #e2231a; --tinta: #111; --gris: #6e7582; }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; background: #fff; -webkit-text-size-adjust: 100%; }
    body { font-family: "Poppins", system-ui, sans-serif; color: var(--tinta); -webkit-tap-highlight-color: transparent; }

    .stage { position: relative; min-height: 100vh; min-height: 100svh; display: grid; place-items: center; padding: 32px 24px; overflow: hidden; }
    .intro, .gift { grid-area: 1 / 1; width: 100%; max-width: 420px; }

    .intro { text-align: center; transition: opacity .5s, transform .6s cubic-bezier(.6, 0, .3, 1); }
    .kicker { font-size: 12px; font-weight: 600; letter-spacing: .24em; text-transform: uppercase; color: var(--azul); animation: up .7s .1s both; }
    .title { font-size: clamp(32px, 9.5vw, 44px); font-weight: 800; line-height: 1.08; letter-spacing: -.02em; margin-top: 12px; animation: up .7s .2s both; }
    .rule { display: block; width: 56px; height: 4px; background: var(--rojo); margin: 22px auto 36px; animation: grow .6s .5s cubic-bezier(.6, 0, .2, 1) both; }

    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 14px;
      width: 100%; max-width: 320px; padding: 20px 28px; border: 0; border-radius: 2px; cursor: pointer;
      font-family: inherit; font-size: 15px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase;
      color: #fff; background: var(--azul);
      box-shadow: 0 12px 26px rgba(11, 63, 168, .28);
      transition: background .2s, transform .15s, box-shadow .2s;
      animation: up .7s .45s both;
      position: relative; overflow: hidden;
    }
    .btn::after { content: ""; position: absolute; inset: 0; background: linear-gradient(100deg, transparent 30%, rgba(255,255,255,.28) 50%, transparent 70%); transform: translateX(-100%); animation: shine 2.8s 1.4s ease-in-out infinite; }
    .btn svg { width: 20px; height: 20px; transition: transform .2s; }
    .btn:hover { background: var(--azul-osc); }
    .btn:hover svg { transform: translateX(4px); }
    .btn:active { transform: scale(.97); box-shadow: 0 6px 14px rgba(11, 63, 168, .25); }
    .note { margin-top: 16px; font-size: 12px; font-weight: 500; letter-spacing: .08em; color: var(--gris); animation: up .7s .6s both; }

    .gift { text-align: center; opacity: 0; transform: translateY(40px) scale(.96); pointer-events: none; transition: opacity .7s .35s, transform .9s .35s cubic-bezier(.2, .8, .2, 1); }
    .gift img { display: block; width: 100%; height: auto; max-height: 76svh; object-fit: contain; box-shadow: 0 24px 50px rgba(17, 24, 39, .18); }
    .again {
      margin-top: 22px; padding: 12px 22px; border: 1.5px solid var(--azul); border-radius: 2px; background: #fff; cursor: pointer;
      font-family: inherit; font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--azul);
    }
    .again:active { transform: scale(.97); }

    #confeti { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 50; }

    .opened .intro { opacity: 0; transform: translateY(-30px); pointer-events: none; }
    .opened .gift { opacity: 1; transform: none; pointer-events: auto; }
    .opened .gift img { animation: rev .07s linear 8 1.2s, rev .07s linear 20 3.7s; }

    @keyframes up { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
    @keyframes grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    @keyframes shine { 0% { transform: translateX(-100%); } 40%, 100% { transform: translateX(100%); } }
    @keyframes rev { 0%, 100% { translate: 0 0; } 50% { translate: 1px -1px; } }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation: none !important; transition-duration: .2s !important; transition-delay: 0s !important; }
    }
  </style>
</body>
</html>
