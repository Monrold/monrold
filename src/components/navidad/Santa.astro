    <g fill="none" stroke-width="2" opacity=".5"><path d="M62 92 q6 5 12 0" /><path d="M98 90 q6 5 12 0" /><path d="M134 90 q6 5 12 0" /><path d="M170 92 q6 5 12 0" /></g>
    <circle cx="214" cy="76" r="18" fill="#fbf5ea" />
    <!-- acebo -->
    <path fill="#3c7a3f" d="M64 82 C56 70 44 72 38 64 C46 62 50 54 58 56 C60 64 70 70 64 82 Z" />
    <path fill="#2f6634" d="M66 82 C70 68 84 66 88 56 C92 64 102 64 104 70 C94 72 82 80 66 82 Z" />
