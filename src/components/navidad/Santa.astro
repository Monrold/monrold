    <circle cx="64" cy="134" r="11" fill="#f2c4a2" />
    <circle cx="176" cy="134" r="11" fill="#f2c4a2" />
    <!-- cara -->
    <ellipse cx="120" cy="132" rx="56" ry="50" fill="#f6d2b4" />
    <!-- barba -->
    <path fill="#fbf5ea" d="M62 134 Q46 160 58 180 Q44 202 64 216 Q60 240 88 242 Q100 260 120 254 Q140 260 152 242 Q180 240 176 216 Q196 202 182 180 Q194 160 178 134 Q164 172 120 174 Q76 172 62 134 Z" />
    <g fill="none" stroke-width="2.4" opacity=".55">
      <path d="M76 196 q8 6 14 0" /><path d="M150 196 q8 6 14 0" /><path d="M92 222 q8 6 14 0" />
      <path d="M134 222 q8 6 14 0" /><path d="M112 238 q8 6 14 0" /><path d="M68 170 q6 6 12 0" /><path d="M160 170 q6 6 12 0" />
