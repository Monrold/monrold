---
// Sello de cera dorado con borde irregular.
const pts: string[] = [];
for (let i = 0; i < 90; i++) {
  const t = (i / 90) * Math.PI * 2;
  const r = 45 + 2.6 * Math.sin(t * 7) + 1.6 * Math.sin(t * 13 + 1.2);
  pts.push(`${(50 + r * Math.cos(t)).toFixed(2)},${(50 + r * Math.sin(t)).toFixed(2)}`);
}
const d = `M${pts.join(" L")} Z`;
---
<svg class="seal-art" viewBox="0 0 100 100" aria-hidden="true">
  <defs>
    <radialGradient id="sealGold" cx="38%" cy="34%" r="70%">
      <stop offset="0" stop-color="#fff1c2" />
      <stop offset=".35" stop-color="#e8c06a" />
      <stop offset=".75" stop-color="#c39136" />
      <stop offset="1" stop-color="#8e6420" />
    </radialGradient>
    <radialGradient id="sealInner" cx="60%" cy="65%" r="70%">
      <stop offset="0" stop-color="#f6d98c" />
      <stop offset="1" stop-color="#b8862e" />
    </radialGradient>
  </defs>
  <path d={d} fill="url(#sealGold)" />
  <circle cx="50" cy="50" r="31" fill="url(#sealInner)" stroke="#9f7222" stroke-width="2.2" />
  <circle cx="50" cy="50" r="26" fill="none" stroke="#fff3c9" stroke-width=".9" opacity=".7" />
  <g stroke="#93681c" stroke-width="2.4" stroke-linecap="round" fill="none">
    <path d="M50 34 V66 M36.1 42 L63.9 58 M36.1 58 L63.9 42" />
    <path d="M45 37 L50 41 L55 37 M45 63 L50 59 L55 63" />
  </g>
</svg>
